{
  "name": "wanwu-shell",
  "version": "1.0.0-beta",
  "private": true,
  "description": "Wanwu Code Desktop — custom Electron shell (not Code-OSS)",
  "main": "dist/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "rebuild:native": "electron-builder install-app-deps",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx src/main/pathSandbox.test.ts && tsx src/main/acpLaunch.test.ts && tsx src/main/acpSession.test.ts && tsx src/main/shellResolve.test.ts && tsx src/main/lsp/uri.test.ts && tsx src/main/lsp/registry.test.ts && tsx src/main/lsp/loadLspConfig.test.ts && tsx src/main/lsp/resolveServer.test.ts && node scripts/afterSign-notarize.test.cjs",
    "dist": "bash ../../scripts/build-shell-dist.sh",
    "dist:builder": "electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@wanwu/acp-client": "workspace:*",
    "@wanwu/config": "workspace:*",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smol-toml": "^1.3.1",
    "typescript": "^5.8.3",
    "typescript-language-server": "^5.0.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.0.1",
    "@electron/packager": "^20.2.1",
    "@types/node": "^22.15.21",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.2.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.5",
    "tsx": "^4.19.4",
    "vite": "^6.3.5"
  },
  "author": "Wanwu <wanwu@example.com>"
}
