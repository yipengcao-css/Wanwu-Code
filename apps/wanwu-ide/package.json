{
  "name": "@wanwu/ide",
  "version": "0.1.0",
  "private": true,
  "description": "Wanwu Code — Electron IDE shell (editor + terminal + Agent/ACP)",
  "author": "Wanwu-Code",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "bundle:backend": "node scripts/bundle-backend.mjs",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-builder install-app-deps || true",
    "dev": "pnpm run bundle:backend && electron-vite dev",
    "build": "pnpm run bundle:backend && electron-vite build",
    "start": "pnpm run build && electron-vite preview",
    "launch": "pnpm run build && electron .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "package:linux": "pnpm run build && electron-builder --linux dir",
    "dist": "pnpm run build && electron-builder"
  },
  "dependencies": {
    "@wanwu/config": "workspace:*",
    "@wanwu/workflow": "workspace:*",
    "chokidar": "^3.6.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@monaco-editor/react": "^4.6.0",
    "@types/node": "^22.15.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^31.7.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.25.5",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.3",
    "vite": "^5.4.11"
  }
}
