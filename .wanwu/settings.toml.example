# Copy to .wanwu/settings.toml for workspace overrides
# Leave model empty until you configure BYOK locally.
#
# active_provider = "openai"
# model = "your-model-id"
# permission_mode = "ask"
# sandbox = "workspace"
# acp_backend = "wanwu-native"
# default_mode = "agent"
#
# [providers.openai]
# api_key_env = "OPENAI_API_KEY"
# base_url = "https://your-api.example"
